APP_FRONTEND_BASE_URL=http://localhost:8810

# Admin Frontend Configuration
ADMIN_FRONTEND_PORT=8811
APP_ADMIN_BASE_URL=http://localhost:8811

# JWT Configuration
JWT_SECRET=SenicBillingNextSuperSecretKey2026!@#$%^&*()_+1234567890
JWT_ISSUER=SenicBillingNext
JWT_AUDIENCE=SenicBillingNextClient
JWT_EXPIRY=480

# Web Push Notifications (VAPID)
VAPID_SUBJECT=mailto:admin@senicsolution.com
VAPID_PUBLIC_KEY=BPZjXb1nsI59-4SiuX2nVa3nsM-mUXAH-J1pgW28O7_4xlNMY5sLQs4hZH-qg6HkiMCl7BT2bXmqXI7v4Mk_zew
VAPID_PRIVATE_KEY=aJx1OcMTViohRk3gktnLg1mZba1MVSIfoq3NSoWugZ4

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ETDA e-Tax XMLDSig Signing Certificate (.p12/.pfx optional)
ETAX_CERT_PATH=
